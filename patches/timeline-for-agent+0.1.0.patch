+import React, { useEffect, useMemo, useState } from "react";
+import {
+  ArchiveIcon,
+  BookmarkIcon,
+  ChevronLeftIcon,
+  ChevronRightIcon,
+  ClockIcon,
+  Cross1Icon,
+  LockClosedIcon,
+  MagnifyingGlassIcon,
+  ReaderIcon,
+  TrashIcon,
+} from "@radix-ui/react-icons";
+
+const ROUTES = new Set(["timeline", "diary", "memory"]);
+const MEMORY_TABS = [
+  { id: "longTerm", label: "Long-term", apiKind: "long-term" },
+  { id: "recent", label: "Recent", apiKind: "recent" },
+  { id: "review", label: "Review", apiKind: "review" },
+];
+
+function PersonalDashboardApp() {
+  const [route, setRoute] = useHashRoute();
+
+  useEffect(() => {
+    const timelineRoot = document.getElementById("root");
+    if (timelineRoot) {
+      timelineRoot.hidden = route !== "timeline";
+    }
+    document.body.dataset.personalRoute = route;
+    return () => {
+      if (timelineRoot) timelineRoot.hidden = false;
+      delete document.body.dataset.personalRoute;
+    };
+  }, [route]);
+
+  return (
+    <div className={`personal-app personal-route-${route}`}>
+      {route === "diary" ? <DiaryPage /> : null}
+      {route === "memory" ? <MemoryPage /> : null}
+      <PersonalNavigation route={route} onNavigate={setRoute} />
+    </div>
+  );
+}
+
+function PersonalNavigation({ route, onNavigate }) {
+  const items = [
+    { id: "timeline", label: "时间轴", Icon: ClockIcon },
+    { id: "diary", label: "日记", Icon: ReaderIcon },
+    { id: "memory", label: "记忆", Icon: ArchiveIcon },
+  ];
+  return (
+    <nav className="personal-bottom-nav" aria-label="个人档案导航">
+      {items.map(({ id, label, Icon }) => (
+        <button
+          key={id}
+          type="button"
+          className="personal-nav-item"
+          data-active={route === id}
+          aria-current={route === id ? "page" : undefined}
+          onClick={() => onNavigate(id)}
+        >
+          <Icon aria-hidden="true" />
+          <span>{label}</span>
+        </button>
+      ))}
+    </nav>
+  );
+}
+
+function DiaryPage() {
+  const [entries, setEntries] = useState([]);
+  const [selectedDate, setSelectedDate] = useState("");
+  const [state, setState] = useState("loading");
+
+  useEffect(() => {
+    let cancelled = false;
+    fetchJson("./__cyberboss/diary")
+      .then((result) => {
+        if (cancelled) return;
+        const nextEntries = Array.isArray(result.entries) ? result.entries : [];
+        setEntries(nextEntries);
+        setSelectedDate(nextEntries[0]?.date || "");
+        setState("ready");
+      })
+      .catch(() => {
+        if (!cancelled) setState("error");
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  const selectedIndex = Math.max(0, entries.findIndex((entry) => entry.date === selectedDate));
+  const selected = entries[selectedIndex] || null;
+  const newer = selectedIndex > 0 ? entries[selectedIndex - 1] : null;
+  const older = selectedIndex + 1 < entries.length ? entries[selectedIndex + 1] : null;
+
+  return (
+    <main className="personal-page diary-page">
+      <PersonalPageHeader title="日记" script="Personal Diary" />
+      <section className="diary-date-controls" aria-label="选择日记日期">
+        <button type="button" disabled={!older} onClick={() => setSelectedDate(older?.date || selectedDate)}>
+          <ChevronLeftIcon />
+          <span>前一天</span>
+        </button>
+        <label className="diary-date-select">
+          <select value={selectedDate} onChange={(event) => setSelectedDate(event.target.value)}>
+            {entries.map((entry) => (
+              <option key={entry.date} value={entry.date}>{formatShortDate(entry.date)}</option>
+            ))}
+          </select>
+        </label>
+        <button type="button" disabled={!newer} onClick={() => setSelectedDate(newer?.date || selectedDate)}>
+          <span>后一天</span>
+          <ChevronRightIcon />
+        </button>
+      </section>
+
+      {state === "loading" ? <PageMessage>正在翻开日记……</PageMessage> : null}
+      {state === "error" ? <PageMessage>日记暂时没有打开，请稍后再试。</PageMessage> : null}
+      {state === "ready" && !selected ? <PageMessage>还没有日记记录。</PageMessage> : null}
+      {selected ? <DiaryEntry entry={selected} /> : null}
+    </main>
+  );
+}
+
+function DiaryEntry({ entry }) {
+  const blocks = useMemo(() => parseDiaryMarkdown(entry.body), [entry.body]);
+  return (
+    <article className="diary-paper">
+      <header className="diary-paper-header">
+        <p>{formatChineseDate(entry.date, { weekday: true })}</p>
+        <span className="diary-flourish" aria-hidden="true">❧</span>
+      </header>
+      <div className="diary-body">
+        {blocks.map((block, index) => {
+          if (block.kind === "heading") {
+            return <h2 key={`${block.kind}:${index}`}>{block.text}</h2>;
+          }
+          if (block.kind === "list") {
+            return <ul key={`${block.kind}:${index}`}>{block.items.map((item) => <li key={item}>{item}</li>)}</ul>;
+          }
+          return <p key={`${block.kind}:${index}`}>{block.text}</p>;
