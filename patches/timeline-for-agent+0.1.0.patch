+        {error ? <p className="memory-dialog-error">{error}</p> : null}
+        <div className="memory-dialog-actions">
+          <button type="button" disabled={deleting} onClick={onCancel}>取消</button>
+          <button type="button" className="danger" disabled={deleting} onClick={onConfirm}>
+            {deleting ? "正在删除……" : "确认删除"}
+          </button>
+        </div>
+      </section>
+    </div>
+  );
+}
+
+function PersonalPageHeader({ title, script }) {
+  return (
+    <header className="personal-page-header" aria-label={title}>
+      <p>{script}</p>
+    </header>
+  );
+}
+
+function PageMessage({ children }) {
+  return <div className="personal-page-message">{children}</div>;
+}
+
+function useHashRoute() {
+  const readRoute = () => {
+    const value = window.location.hash.replace(/^#\/?/, "").trim().toLowerCase();
+    return ROUTES.has(value) ? value : "timeline";
+  };
+  const [route, setRoute] = useState(readRoute);
+  useEffect(() => {
+    const onHashChange = () => setRoute(readRoute());
+    window.addEventListener("hashchange", onHashChange);
+    return () => window.removeEventListener("hashchange", onHashChange);
+  }, []);
+  const navigate = (nextRoute) => {
+    const normalized = ROUTES.has(nextRoute) ? nextRoute : "timeline";
+    if (normalized === "timeline") {
+      window.history.pushState(null, "", `${window.location.pathname}${window.location.search}`);
+      setRoute("timeline");
+      window.scrollTo({ top: 0, behavior: "smooth" });
+      return;
+    }
+    window.location.hash = normalized;
+  };
+  return [route, navigate];
+}
+
+function parseDiaryMarkdown(source) {
+  const lines = String(source || "").replace(/^---\s*\n[\s\S]*?\n---\s*\n?/, "").split(/\r?\n/);
+  const blocks = [];
+  let paragraph = [];
+  let list = [];
+  const flushParagraph = () => {
+    if (paragraph.length) blocks.push({ kind: "paragraph", text: paragraph.join(" ").trim() });
+    paragraph = [];
+  };
+  const flushList = () => {
+    if (list.length) blocks.push({ kind: "list", items: list });
+    list = [];
+  };
+  for (const line of lines) {
+    const heading = line.match(/^#{1,6}\s+(.+)$/);
+    const listItem = line.match(/^\s*[-*+]\s+(.+)$/);
+    if (heading) {
+      flushParagraph();
+      flushList();
+      blocks.push({ kind: "heading", text: cleanMarkdownText(heading[1]) });
+    } else if (listItem) {
+      flushParagraph();
+      list.push(cleanMarkdownText(listItem[1]));
+    } else if (!line.trim()) {
+      flushParagraph();
+      flushList();
+    } else {
+      flushList();
+      paragraph.push(cleanMarkdownText(line));
+    }
+  }
+  flushParagraph();
+  flushList();
+  return blocks;
+}
+
+function cleanMarkdownText(value) {
+  return String(value || "")
+    .replace(/\*\*(.*?)\*\*/g, "$1")
+    .replace(/_(.*?)_/g, "$1")
+    .replace(/`(.*?)`/g, "$1")
+    .trim();
+}
+
+function memoryTitle(item, tab) {
+  if (tab !== "recent") return item.name || item.description || "未命名记忆";
+  const name = String(item.name || "").trim();
+  if (name) return name;
+  const description = String(item.description || "").trim();
+  if (description && description !== String(item.content || "").trim()) return description;
+  const content = String(item.content || "").trim();
+  return content.length > 24 ? `${content.slice(0, 24)}…` : content || "近期记忆";
+}
+
+function memoryContent(item, tab) {
+  if (tab === "longTerm") return item.content || item.description || "";
+  if (tab === "review") return item.content || item.description || "";
+  return item.content || "";
+}
+
+function translateMemoryType(value) {
+  const labels = {
+    preference: "偏好",
+    feedback: "反馈",
+    profile: "资料",
+    project: "项目",
+    reference: "参考",
+    state: "状态",
+    event: "事件",
+    topic: "话题",
+    plan: "计划",
+  };
+  return labels[String(value || "").toLowerCase()] || "记忆";
+}
+
+function compareMemories(left, right, order) {
+  if (order === "name") {
+    return memoryTitle(left, "longTerm").localeCompare(memoryTitle(right, "longTerm"), "zh-CN");
+  }
+  const leftTime = Date.parse(left.updatedAt || left.createdAt || left.expiresAt || "") || 0;
+  const rightTime = Date.parse(right.updatedAt || right.createdAt || right.expiresAt || "") || 0;
+  return order === "oldest" ? leftTime - rightTime : rightTime - leftTime;
+}
+
+function formatCompactDate(value) {
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) return "";
+  return new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).format(date);
+}
+
+function formatChineseDate(value, { weekday = false } = {}) {
+  const date = new Date(`${value}T12:00:00`);
+  if (Number.isNaN(date.getTime())) return value;
+  return new Intl.DateTimeFormat("zh-CN", {
+    year: "numeric",
+    month: "long",
+    day: "numeric",
+    ...(weekday ? { weekday: "long" } : {}),
+  }).format(date);
+}
+
+function formatShortDate(value) {
+  const date = new Date(`${value}T12:00:00`);
+  if (Number.isNaN(date.getTime())) return value;
+  return new Intl.DateTimeFormat("zh-CN", { month: "numeric", day: "numeric" }).format(date);
+}
+
+async function fetchJson(url, options = {}) {
+  const response = await fetch(url, {
+    credentials: "same-origin",
+    cache: "no-store",
+    ...options,
+  });
+  if (!response.ok) {
+    throw new Error(`request failed: ${response.status}`);
+  }
+  return response.json();
+}
+
+export { PersonalDashboardApp };
