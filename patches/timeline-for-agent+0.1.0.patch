+          longTerm: Array.isArray(result.longTerm) ? result.longTerm : [],
+          recent: Array.isArray(result.recent) ? result.recent : [],
+          review: Array.isArray(result.review) ? result.review : [],
+        });
+        setState("ready");
+      })
+      .catch(() => {
+        if (!cancelled) setState("error");
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  const activeItems = useMemo(() => {
+    const normalizedQuery = query.trim().toLowerCase();
+    const filtered = data[activeTab].filter((item) => {
+      if (!normalizedQuery) return true;
+      return [item.name, item.description, item.content, item.evidence, item.type, item.kind]
+        .filter(Boolean)
+        .join("\n")
