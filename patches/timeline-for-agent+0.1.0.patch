+  const error = new Error(message);
+  error.statusCode = 400;
+  return error;
+}
+
+function notFound(message) {
+  const error = new Error(message);
+  error.statusCode = 404;
+  return error;
+}
+
+module.exports = {
+  createPersonalDashboardApi,
+  deleteMemory,
+  listDiaryEntries,
+  listMemories,
+};
