+
+  const visibleItems = activeItems.slice(0, visibleCount);
+
+  async function confirmDelete() {
+    if (!deleteTarget || deleting) return;
+    setDeleting(true);
+    setDeleteError("");
+    try {
+      await fetchJson(`./__cyberboss/memories/${encodeURIComponent(deleteTarget.apiKind)}/${encodeURIComponent(deleteTarget.id)}`, {
+        method: "DELETE",
+        headers: { "x-cyberboss-dashboard": "1" },
+      });
