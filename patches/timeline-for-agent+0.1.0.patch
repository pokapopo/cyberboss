+function findOverlappingEvent(existingMap, incoming) {
+  const inStart = Date.parse(incoming.startAt);
+  const inEnd = Date.parse(incoming.endAt);
+  for (const existing of existingMap.values()) {
+    const exStart = Date.parse(existing.startAt);
+    const exEnd = Date.parse(existing.endAt);
+    const overlapStart = Math.max(inStart, exStart);
+    const overlapEnd = Math.min(inEnd, exEnd);
+    const overlapMs = overlapEnd - overlapStart;
+    if (overlapMs <= 0) continue;
+    const shorterMs = Math.min(inEnd - inStart, exEnd - exStart);
+    if (overlapMs >= shorterMs * 0.5) {
+      if (incoming.subcategoryId === existing.subcategoryId) return existing;
+      if (incoming.title && existing.title && similarTitle(incoming.title, existing.title)) return existing;
+    }
+  }
+  return null;
+}
+
+function similarTitle(a, b) {
+  const na = a.replace(/\+/g, '').replace(/\//g, '').trim();
+  const nb = b.replace(/\+/g, '').replace(/\//g, '').trim();
+  return na === nb || na.includes(nb) || nb.includes(na);
+}
