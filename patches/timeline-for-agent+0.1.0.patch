@@ -0,0 +1,475 @@
+const fs = require("fs");
+const path = require("path");
+
+const DATE_FILE_RE = /^(\d{4}-\d{2}-\d{2})\.md$/;
+const MEMORY_FILE_RE = /^[^/\\\0]+\.md$/u;
+const MAX_BODY_BYTES = 16 * 1024;
+const LOCK_SLEEP_BUFFER = new SharedArrayBuffer(4);
+const LOCK_SLEEP_VIEW = new Int32Array(LOCK_SLEEP_BUFFER);
+
+function createPersonalDashboardApi({ stateDir }) {
+  const root = path.resolve(String(stateDir || ""));
+  const diaryDir = path.join(root, "diary");
+  const memoryDir = path.join(root, "memory");
+  const recentMemoryFile = path.join(root, "recent-memory.json");
+  const candidatesFile = path.join(root, "memory-candidates.json");
+  const indexFile = path.join(root, "memory-search", "embeddings.json");
+  const trashDir = path.join(root, "memory-trash", "dashboard");
+
+  return async function handlePersonalDashboardApi(request, response) {
+    const url = new URL(request.url || "/", "http://127.0.0.1");
+    if (!url.pathname.startsWith("/__cyberboss/")) {
+      return false;
+    }
+
+    try {
+      if (request.method === "GET" && url.pathname === "/__cyberboss/diary") {
+        sendJson(response, 200, { entries: listDiaryEntries(diaryDir) });
+        return true;
+      }
+      if (request.method === "GET" && url.pathname === "/__cyberboss/memories") {
+        sendJson(response, 200, listMemories({ memoryDir, recentMemoryFile, candidatesFile }));
+        return true;
+      }
+      if (request.method === "DELETE" && url.pathname.startsWith("/__cyberboss/memories/")) {
+        if (request.headers["x-cyberboss-dashboard"] !== "1") {
+          sendJson(response, 403, { error: "missing dashboard request header" });
+          return true;
+        }
+        const parts = url.pathname.split("/").filter(Boolean);
+        const kind = decodeURIComponent(parts[2] || "");
+        const id = decodeURIComponent(parts.slice(3).join("/") || "");
+        const result = deleteMemory({
+          kind,
+          id,
+          memoryDir,
+          recentMemoryFile,
+          candidatesFile,
+          indexFile,
+          trashDir,
+        });
+        sendJson(response, 200, result);
+        return true;
+      }
+      if (request.method === "POST" && url.pathname.startsWith("/__cyberboss/memories/review/")) {
+        if (request.headers["x-cyberboss-dashboard"] !== "1") {
+          sendJson(response, 403, { error: "missing dashboard request header" });
+          return true;
+        }
+        const parts = url.pathname.split("/").filter(Boolean);
+        const id = decodeURIComponent(parts[3] || "");
+        const action = String(parts[4] || "").toLowerCase();
+        if (!id || !["approve", "approve-recent", "approve-durable", "reject"].includes(action)) {
+          throw badRequest("invalid review action");
+        }
+        const result = reviewMemoryCandidate({ action, id, memoryDir, recentMemoryFile, candidatesFile });
+        sendJson(response, 200, result);
+        return true;
+      }
+      sendJson(response, 404, { error: "not found" });
+      return true;
+    } catch (error) {
+      const status = error?.code === "ENOENT" ? 404 : error?.statusCode || 500;
+      sendJson(response, status, { error: status >= 500 ? "dashboard request failed" : error.message });
+      return true;
+    }
+  };
+}
+
+function listDiaryEntries(diaryDir) {
+  if (!fs.existsSync(diaryDir)) {
+    return [];
+  }
+  return fs.readdirSync(diaryDir, { withFileTypes: true })
+    .filter((entry) => entry.isFile() && DATE_FILE_RE.test(entry.name))
+    .map((entry) => {
+      const date = entry.name.match(DATE_FILE_RE)[1];
+      const filePath = path.join(diaryDir, entry.name);
+      const body = fs.readFileSync(filePath, "utf8").slice(0, MAX_BODY_BYTES);
+      const title = extractDiaryTitle(body) || formatChineseDate(date);
+      return {
+        id: date,
+        date,
+        title,
+        preview: markdownToPlainText(body).slice(0, 140),
+        body,
+      };
+    })
+    .sort((left, right) => right.date.localeCompare(left.date));
+}
+
+function listMemories({ memoryDir, recentMemoryFile, candidatesFile }) {
+  const longTerm = fs.existsSync(memoryDir)
+    ? fs.readdirSync(memoryDir, { withFileTypes: true })
+      .filter((entry) => entry.isFile() && MEMORY_FILE_RE.test(entry.name) && entry.name !== "MEMORY.md")
+      .map((entry) => readLongTermMemory(path.join(memoryDir, entry.name), entry.name))
+      .filter(Boolean)
+      .sort(sortNewest)
+    : [];
+
+  const recentState = readJson(recentMemoryFile, { entries: [] });
+  const recent = (Array.isArray(recentState.entries) ? recentState.entries : [])
+    .map((entry) => ({
+      id: String(entry.id || ""),
+      type: String(entry.type || "reference"),
+      kind: String(entry.kind || "event"),
+      status: String(entry.status || "active"),
+      name: String(entry.name || ""),
+      description: String(entry.description || ""),
+      content: String(entry.summary || ""),
+      evidence: String(entry.evidence || ""),
+      sensitive: Boolean(entry.sensitive),
+      createdAt: String(entry.createdAt || ""),
+      expiresAt: String(entry.expiresAt || ""),
+      hitCount: Math.max(0, Number(entry.hitCount) || 0),
+    }))
+    .filter((entry) => entry.id && entry.content)
+    .sort(sortNewest);
+
+  const candidateState = readJson(candidatesFile, { candidates: [] });
+  const review = (Array.isArray(candidateState.candidates) ? candidateState.candidates : [])
+    .filter((entry) => String(entry.status || "pending") === "pending")
+    .map((entry) => ({
+      id: String(entry.id || ""),
+      type: String(entry.type || "reference"),
+      name: String(entry.name || "待确认记忆"),
+      description: String(entry.description || ""),
+      content: String(entry.content || ""),
+      evidence: String(entry.evidence || ""),
+      sensitive: Boolean(entry.sensitive),
+      retention: ["recent", "durable"].includes(String(entry.retention || "")) ? String(entry.retention) : "",
+      kind: String(entry.kind || ""),
+      confidence: Number(entry.confidence) || 0,
+      createdAt: String(entry.createdAt || ""),
+    }))
+    .filter((entry) => entry.id && entry.content)
+    .sort(sortNewest);
+
+  return { longTerm, recent, review };
+}
+
+function readLongTermMemory(filePath, fileName) {
+  const source = fs.readFileSync(filePath, "utf8").slice(0, MAX_BODY_BYTES);
+  const stats = fs.statSync(filePath);
+  const frontmatter = parseFrontmatter(source);
+  const markdownBody = source.replace(/^---\s*\n[\s\S]*?\n---\s*\n?/, "");
+  const heading = markdownBody.match(/^#\s+(.+)$/m)?.[1]?.trim() || "";
+  const content = markdownBody
+    .replace(/^#\s+.+$/m, "")
+    .trim();
+  return {
+    id: fileName,
+    type: frontmatter.type || fileName.split("-")[0] || "reference",
+    name: frontmatter.name || heading || fileName.replace(/\.md$/i, ""),
+    description: frontmatter.description || "",
+    content,
+    createdAt: stats.birthtime.toISOString(),
+    updatedAt: stats.mtime.toISOString(),
+  };
+}
+
+function deleteMemory({ kind, id, memoryDir, recentMemoryFile, candidatesFile, indexFile, trashDir }) {
+  if (kind === "long-term") {
+    if (!MEMORY_FILE_RE.test(id) || id === "MEMORY.md" || path.basename(id) !== id) {
+      throw badRequest("invalid memory id");
+    }
+    const sourcePath = path.join(memoryDir, id);
+    if (!fs.existsSync(sourcePath) || !fs.statSync(sourcePath).isFile()) {
+      throw notFound("memory not found");
+    }
+    fs.mkdirSync(trashDir, { recursive: true, mode: 0o700 });
+    const trashPath = uniqueTrashPath(trashDir, id);
+    fs.renameSync(sourcePath, trashPath);
+    removeIndexEntry(indexFile, id);
+    return { deleted: true, kind, id, recoverable: true };
+  }
+
+  if (kind === "recent") {
+    withFileLockSync(recentMemoryFile, () => {
+      const state = readJson(recentMemoryFile, { version: 1, entries: [] });
+      const entries = Array.isArray(state.entries) ? state.entries : [];
+      const target = entries.find((entry) => String(entry.id || "") === id);
+      if (!target) {
+        throw notFound("memory not found");
+      }
+      recordDeletedJson(trashDir, { kind, deletedAt: new Date().toISOString(), entry: target });
+      state.entries = entries.filter((entry) => String(entry.id || "") !== id);
+      writeJsonAtomic(recentMemoryFile, state);
+    });
+    return { deleted: true, kind, id, recoverable: true };
+  }
+
+  if (kind === "review") {
+    withFileLockSync(candidatesFile, () => {
+      const state = readJson(candidatesFile, { version: 1, candidates: [] });
+      const candidates = Array.isArray(state.candidates) ? state.candidates : [];
+      const target = candidates.find((entry) => String(entry.id || "") === id);
+      if (!target || String(target.status || "pending") !== "pending") {
+        throw notFound("candidate not found");
+      }
+      target.status = "rejected";
+      target.reviewedAt = new Date().toISOString();
+      writeJsonAtomic(candidatesFile, state);
+    });
+    return { deleted: true, kind, id, recoverable: true };
+  }
+
+  throw badRequest("invalid memory kind");
+}
+
+function reviewMemoryCandidate({ action, id, memoryDir, recentMemoryFile, candidatesFile }) {
+  let approved = null;
+  withFileLockSync(candidatesFile, () => {
+    const state = readJson(candidatesFile, { version: 1, candidates: [] });
+    const candidates = Array.isArray(state.candidates) ? state.candidates : [];
+    const target = candidates.find((entry) => String(entry.id || "") === id && String(entry.status || "pending") === "pending");
+    if (!target) throw notFound("candidate not found");
+    const approvedRetention = action === "approve-recent"
+      ? "recent"
+      : action === "approve-durable"
+        ? "durable"
+        : resolveCandidateRetention(target);
+    if (action.startsWith("approve")) {
+      approved = approvedRetention === "recent"
+        ? writeApprovedRecent(recentMemoryFile, target)
+        : writeApprovedMemory(memoryDir, target);
+    }
+    target.status = action.startsWith("approve") ? "approved" : "rejected";
+    target.reviewedAt = new Date().toISOString();
+    target.approvedRetention = action.startsWith("approve") ? approvedRetention : "";
+    target.savedFile = approved?.file || "";
+    writeJsonAtomic(candidatesFile, state);
+  });
+  return { reviewed: true, action, id, saved: approved };
+}
+
+function resolveCandidateRetention(candidate) {
+  if (candidate.retention === "recent" || candidate.retention === "durable") {
+    return candidate.retention;
+  }
+  return candidate.type === "project" ? "recent" : "durable";
+}
+
+function writeApprovedRecent(recentMemoryFile, candidate) {
+  return withFileLockSync(recentMemoryFile, () => {
+    const now = new Date();
+    const expiresAt = new Date(now.getTime() + 14 * 24 * 60 * 60 * 1000);
+    const state = readJson(recentMemoryFile, { version: 1, entries: [] });
+    const entries = Array.isArray(state.entries) ? state.entries : [];
+    const id = `recent_memory_dashboard_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
+    entries.push({
+      id,
+      type: candidate.type || "reference",
+      kind: candidate.kind || "event",
+      status: candidate.status || "active",
+      summary: String(candidate.content || ""),
+      evidence: String(candidate.evidence || ""),
+      createdAt: now.toISOString(),
+      expiresAt: expiresAt.toISOString(),
+      hitCount: 0,
+      lastHitAt: "",
+    });
+    state.version = 1;
+    state.entries = entries.slice(-60);
+    writeJsonAtomic(recentMemoryFile, state);
+    return { id, kind: "recent", name: candidate.name || "近期记忆" };
+  });
+}
+
+function writeApprovedMemory(memoryDir, candidate) {
+  fs.mkdirSync(memoryDir, { recursive: true, mode: 0o700 });
+  const baseName = `${candidate.type || "reference"}-${slugify(candidate.name) || "memory"}`;
+  let fileName = `${baseName}.md`;
+  let counter = 2;
+  while (fs.existsSync(path.join(memoryDir, fileName))) {
+    fileName = `${baseName}-${counter}.md`;
+    counter += 1;
+  }
+  const body = [
+    "---",
+    `name: ${sanitizeFrontmatter(candidate.name || "未命名记忆")}`,
+    `description: ${sanitizeFrontmatter(candidate.description || "")}`,
+    `type: ${sanitizeFrontmatter(candidate.type || "reference")}`,
+    "---",
+    `# ${candidate.name || "未命名记忆"}`,
+    "",
+    String(candidate.content || ""),
+    "",
+  ].join("\n");
+  fs.writeFileSync(path.join(memoryDir, fileName), body, { encoding: "utf8", mode: 0o600, flag: "wx" });
+  return { file: fileName, name: candidate.name || "未命名记忆", type: candidate.type || "reference" };
+}
+
+function slugify(value) {
+  return String(value || "")
+    .toLowerCase()
+    .replace(/[^a-z0-9\u4e00-\u9fff]+/gu, "-")
+    .replace(/^-+|-+$/g, "")
+    .slice(0, 80);
+}
+
+function sanitizeFrontmatter(value) {
+  return String(value || "").replace(/[\r\n]+/g, " ").replace(/:/g, " -").trim();
+}
+
+function removeIndexEntry(indexFile, fileName) {
+  withFileLockSync(indexFile, () => {
+    const index = readJson(indexFile, {});
+    if (Object.prototype.hasOwnProperty.call(index, fileName)) {
+      delete index[fileName];
+      writeJsonAtomic(indexFile, index);
+    }
+  });
+}
+
+function recordDeletedJson(trashDir, record) {
+  fs.mkdirSync(trashDir, { recursive: true, mode: 0o700 });
+  const filePath = path.join(trashDir, "deleted-state.json");
+  withFileLockSync(filePath, () => {
+    const state = readJson(filePath, { version: 1, records: [] });
+    const records = Array.isArray(state.records) ? state.records : [];
+    records.push(record);
+    state.records = records.slice(-200);
+    writeJsonAtomic(filePath, state);
+  });
+}
+
+function uniqueTrashPath(trashDir, fileName) {
+  const extension = path.extname(fileName);
+  const stem = path.basename(fileName, extension);
+  const stamp = new Date().toISOString().replace(/[:.]/g, "-");
+  return path.join(trashDir, `${stem}-${stamp}${extension}`);
+}
+
+function parseFrontmatter(source) {
+  const match = String(source || "").match(/^---\s*\n([\s\S]*?)\n---/);
+  if (!match) {
+    return {};
+  }
+  return Object.fromEntries(match[1].split(/\r?\n/).map((line) => {
+    const separator = line.indexOf(":");
+    if (separator < 1) {
+      return null;
+    }
+    return [line.slice(0, separator).trim(), line.slice(separator + 1).trim()];
+  }).filter(Boolean));
+}
+
+function extractDiaryTitle(source) {
+  return String(source || "").match(/^#{1,3}\s+(.+)$/m)?.[1]?.trim() || "";
+}
+
+function markdownToPlainText(source) {
+  return String(source || "")
+    .replace(/^---\s*\n[\s\S]*?\n---\s*\n?/, "")
+    .replace(/^#{1,6}\s+/gm, "")
+    .replace(/[*_`>~-]/g, "")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+function formatChineseDate(value) {
+  const [year, month, day] = value.split("-");
+  return `${year}年${Number(month)}月${Number(day)}日`;
+}
+
+function sortNewest(left, right) {
+  const leftTime = Date.parse(left.updatedAt || left.createdAt || "") || 0;
+  const rightTime = Date.parse(right.updatedAt || right.createdAt || "") || 0;
+  return rightTime - leftTime;
+}
+
+function readJson(filePath, fallback) {
+  try {
+    return JSON.parse(fs.readFileSync(filePath, "utf8"));
+  } catch (error) {
+    if (error?.code === "ENOENT") {
+      return structuredClone(fallback);
+    }
+    throw error;
+  }
+}
+
+function writeJsonAtomic(filePath, value) {
+  fs.mkdirSync(path.dirname(filePath), { recursive: true, mode: 0o700 });
+  const tempPath = path.join(
+    path.dirname(filePath),
+    `.${path.basename(filePath)}.${process.pid}.${Date.now()}.${Math.random().toString(36).slice(2)}.tmp`
+  );
+  let fd;
+  try {
+    fd = fs.openSync(tempPath, "wx", 0o600);
+    fs.writeFileSync(fd, `${JSON.stringify(value, null, 2)}\n`, "utf8");
+    fs.fsyncSync(fd);
+    fs.closeSync(fd);
+    fd = undefined;
+    fs.renameSync(tempPath, filePath);
+    try {
+      fs.chmodSync(filePath, 0o600);
+    } catch {
+      // Best effort on platforms without chmod support.
+    }
+  } finally {
+    if (fd !== undefined) {
+      try { fs.closeSync(fd); } catch {}
+    }
+    try { fs.unlinkSync(tempPath); } catch {}
+  }
+}
