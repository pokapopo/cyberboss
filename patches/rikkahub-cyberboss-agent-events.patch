+    /**
+     * Cyberboss is an Agent runtime, so its tools have already run on the server.
+     * Convert its optional SSE extension into the existing Tool part used by the
+     * native RikkaHub renderer. A completed event carries non-empty output, which
+     * also prevents GenerationHandler from executing the tool a second time.
+     */
+    private fun parseCyberbossEvent(event: JsonObject?): UIMessage? {
+        if (event?.get("protocol")?.jsonPrimitiveOrNull?.contentOrNull != "cyberboss.agent.v1") {
+            return null
+        }
+        val type = event["type"]?.jsonPrimitiveOrNull?.contentOrNull ?: return null
+        val toolCallId = event["tool_call_id"]?.jsonPrimitiveOrNull?.contentOrNull ?: return null
+        val toolName = event["name"]?.jsonPrimitiveOrNull?.contentOrNull ?: ""
+        val part = when (type) {
+            "tool.started" -> UIMessagePart.Tool(
+                toolCallId = toolCallId,
+                toolName = toolName,
+                input = event["arguments"]?.toString() ?: "{}",
+                output = emptyList(),
+            )
+
+            "tool.completed" -> {
+                val content = event["content"]?.jsonPrimitiveOrNull?.contentOrNull.orEmpty()
+                UIMessagePart.Tool(
+                    toolCallId = toolCallId,
+                    // Tool.merge appends streaming name/input fragments. The
+                    // started event already supplied both, so keep these empty.
+                    toolName = "",
+                    input = "",
+                    output = listOf(
+                        UIMessagePart.Text(
+                            content.ifEmpty { "(completed without textual output)" }
+                        )
+                    ),
+                )
+            }
+
+            else -> return null
+        }
+        return UIMessage(
+            role = MessageRole.ASSISTANT,
+            parts = listOf(part),
+        )
+    }
